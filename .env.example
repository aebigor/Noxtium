# NOXTIUM LOCAL

SECRET_KEY=pon-un-secret-largo

# PostgreSQL local
DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@localhost:5432/noxtium

# Meta: configuración GLOBAL de la aplicación Noxtium
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=

# Activos Meta de prueba visibles en tu captura.
# NO son la configuración de clientes reales.
META_TEST_PHONE_NUMBER_ID=1260263758592789
META_TEST_WABA_ID=1664973758592789

# Cifrado de tokens
FERNET_KEY=

# n8n local
N8N_WEBHOOK_URL=http://localhost:5678/webhook/noxtium-whatsapp
N8N_WEBHOOK_SECRET=
# Webhook separado para preparar/activar agentes. Debe responder JSON {"ready": true} al evento agent.activate.
N8N_PROVISION_WEBHOOK_URL=

# Desarrollo local
DEMO_COMPANY_ID=
DEVELOPMENT_PAYMENT_DEMO=true

# Administración
ADMIN_EMAILS=noxtium@noxtium.com

# Pagos manuales Nequi
NEQUI_PHONE=
NEQUI_ACCOUNT_NAME=NOXTIUM
NEQUI_QR_URL=/static/uploads/nequi-qr.png

# Contacto comercial para preconsultas (opcional)
CONSULTATION_WHATSAPP=

# Webhook separado para avisar a n8n cuando se agenda una preconsulta
N8N_CONSULTATION_WEBHOOK_URL=
