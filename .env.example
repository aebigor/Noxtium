# Copia este archivo a .env y completa los valores locales. Nunca compartas .env.
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_LARGO
DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@localhost:5432/noxtium
ADMIN_EMAILS=tu-correo-admin@ejemplo.com

# WhatsApp QR (servicio Node/Baileys, integración no oficial)
QR_WHATSAPP_SERVICE_URL=http://127.0.0.1:3010
QR_WHATSAPP_API_SECRET=CAMBIA_POR_UN_SECRETO_LARGO_IGUAL_EN_NODE
QR_WHATSAPP_TEST_MODE=true
QR_WHATSAPP_TEST_RECIPIENTS=573001234567

# n8n: URL de webhook y secreto compartido con el flujo
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/noxtium-whatsapp
N8N_WEBHOOK_SECRET=CAMBIA_POR_UN_SECRETO
N8N_PROVISION_WEBHOOK_URL=
N8N_CONSULTATION_WEBHOOK_URL=

# Pagos manuales / soporte (opcionales)
NEQUI_PHONE=
NEQUI_ACCOUNT_NAME=NOXTIUM
NEQUI_QR_URL=/static/uploads/nequi-qr.png
CONSULTATION_WHATSAPP=
